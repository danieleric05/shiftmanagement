# ---------------------------------------------------------------------------
# ShiftManagement — modèle de .env pour le staging Plesk
# https://staging.daertech.ci (document root : staging.daertech.ci/public)
#
# Copier ce fichier en `.env` à la racine du projet sur le serveur
# (Gestionnaire de fichiers Plesk), puis remplacer chaque « À_REMPLIR ».
# Ne JAMAIS committer le `.env` réel.
# ---------------------------------------------------------------------------

APP_NAME=ShiftManagement
APP_ENV=production
APP_DEBUG=false
APP_URL=https://staging.daertech.ci

# Générer une clé avec : php artisan key:generate --show
# (ou en local, puis coller la valeur « base64:... » ici).
# Si vous importez la base Railway, réutilisez la MÊME clé que sur Railway :
# sinon les sessions/valeurs chiffrées existantes deviennent illisibles.
APP_KEY=
# Anciennes clés (rotation), séparées par des virgules. Laisser vide.
APP_PREVIOUS_KEYS=

# Interface en français. Le projet n'a pas de dossier lang/ : les messages
# du framework non traduits retombent sur l'anglais (fallback).
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Logs dans storage/logs/laravel-AAAA-MM-JJ.log, conservés 14 jours.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Base MySQL créée dans Plesk (Bases de données > Ajouter une base).
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=À_REMPLIR
DB_USERNAME=À_REMPLIR
DB_PASSWORD=À_REMPLIR

# Sessions en base (table `sessions` créée par les migrations).
# Cookie uniquement en HTTPS : le site doit être servi en https:// (Let's Encrypt).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
# Les photos des servants sont stockées sur le disque « local »
# (storage/app/private), pas sur un service externe.
FILESYSTEM_DISK=local

# Aucune tâche n'est mise en file actuellement (notifications « database »
# synchrones) : pas de worker nécessaire. `database` reste un choix sûr.
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Proxies : bootstrap/app.php fait déjà `trustProxies(at: '*')`, donc le
# nginx de Plesk (X-Forwarded-Proto: https) est reconnu. Aucune variable
# TRUSTED_PROXIES n'est lue par l'application.

# Mail : utilisé pour « Mot de passe oublié » (envoi synchrone).
# Laisser `log` tant qu'aucune boîte n'est configurée (les e-mails finissent
# alors dans storage/logs). Pour envoyer réellement, créer une boîte dans
# Plesk (ex. no-reply@daertech.ci) et décommenter :
MAIL_MAILER=log
# MAIL_MAILER=smtp
# MAIL_SCHEME=smtps
# MAIL_HOST=À_REMPLIR (ex. le serveur mail Plesk, souvent mail.daertech.ci)
# MAIL_PORT=465
# MAIL_USERNAME=À_REMPLIR
# MAIL_PASSWORD=À_REMPLIR
MAIL_FROM_ADDRESS="no-reply@daertech.ci"
MAIL_FROM_NAME="${APP_NAME}"

# Sauvegarde HTTP de la base : GET /system/backup avec l'en-tête
# X-Backup-Token. Vide = route désactivée (403). Si utilisée, mettre une
# longue valeur aléatoire (ex. `openssl rand -hex 32`).
BACKUP_TOKEN=

VITE_APP_NAME="${APP_NAME}"
